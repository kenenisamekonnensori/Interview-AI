{
  "name": "@interviewer-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/workers/auth-email.worker.ts src/workers/career-analysis.worker.ts src/workers/report.worker.ts --format esm --target node22 --external dotenv --external dotenv/config --clean",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "pretypecheck": "pnpm prisma:generate",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/career-analysis.worker.js",
    "start:auth-email-worker": "node dist/workers/auth-email.worker.js",
    "start:career-analysis-worker": "node dist/workers/career-analysis.worker.js",
    "start:report-worker": "node dist/workers/report.worker.js",
    "queue:inspect": "tsx src/scripts/queue-recovery.ts inspect career-analysis",
    "queue:retry": "tsx src/scripts/queue-recovery.ts retry career-analysis",
    "cleanup:resume-uploads": "tsx src/scripts/cleanup-resume-uploads.ts",
    "account:delete": "tsx src/scripts/delete-account.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@deepgram/sdk": "^5.6.0",
    "@fastify/cors": "^11.1.0",
    "@interviewer-ai/config": "workspace:*",
    "@interviewer-ai/prompts": "workspace:*",
    "@interviewer-ai/types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.8",
    "fastify": "^5.6.1",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.0",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "resend": "^6.17.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.10"
  }
}
