{
  "name": "@interviewer-ai/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsup src/server.ts --format esm --target node22 --clean",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "pretypecheck": "pnpm prisma:generate",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.23",
    "@fastify/cors": "^11.1.0",
    "@interviewer-ai/config": "workspace:*",
    "@interviewer-ai/types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "fastify": "^5.6.1",
    "pg": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
