{
  "name": "@interviewer-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/workers/auth-email.worker.ts --format esm --target node22 --external dotenv --external dotenv/config --clean",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "pretypecheck": "pnpm prisma:generate",
    "start": "node dist/server.js",
    "start:auth-email-worker": "node dist/workers/auth-email.worker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@fastify/cors": "^11.1.0",
    "@interviewer-ai/config": "workspace:*",
    "@interviewer-ai/types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.8",
    "fastify": "^5.6.1",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "resend": "^6.17.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
