generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  authEmailOutbox    AuthEmailOutbox[]
  sessions           Session[]
  resumes            Resume[]
  jobDescriptions    JobDescription[]
  careerTargets      CareerTarget[]
  interviews         Interview[]
  profile            UserProfile?
  skillAnalysis      SkillAnalysis?
  practicePlan       PracticePlan?
  readinessSnapshots ReadinessSnapshot[]
  billingCustomers   BillingCustomer[]
  subscriptions      Subscription[]
  usageRecords       UsageRecord[]
  usageCounters      UsageCounter[]
  billingEvents      BillingEvent[]

  @@map("user")
}

model UserProfile {
  id                       String              @id @default(uuid())
  userId                   String              @unique
  preferredName            String?
  profession               String?
  targetRole               String?
  seniority                String?
  yearsOfExperience        Int?
  preferredLanguage        String              @default("en")
  defaultInterviewDuration Int                 @default(30)
  defaultDifficulty        InterviewDifficulty @default(MEDIUM)
  voicePreference          String?
  accessibilityPreferences Json                @default("{}")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

enum ResumeStatus {
  PENDING_UPLOAD
  READY
  ANALYZING
  ANALYZED
  FAILED
  DELETED
}

model Resume {
  id            String          @id @default(uuid())
  userId        String
  storageKey    String          @unique
  fileName      String
  mimeType      String
  fileSize      Int
  status        ResumeStatus    @default(PENDING_UPLOAD)
  isActive      Boolean         @default(false)
  uploadedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis      ResumeAnalysis?
  careerTargets CareerTarget[]
  interviews    Interview[]

  @@index([userId, createdAt])
  @@index([userId, isActive])
  @@index([userId, deletedAt, isActive, createdAt])
  @@map("resume")
}

model ResumeAnalysis {
  id             String   @id @default(uuid())
  resumeId       String   @unique
  summary        String
  skills         Json
  technologies   Json
  experience     Json
  education      Json
  projects       Json
  certifications Json
  generatedAt    DateTime @default(now())
  model          String
  version        Int      @default(1)
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analysis")
}

enum JobDescriptionStatus {
  READY
  ANALYZING
  ANALYZED
  FAILED
  DELETED
}

model JobDescription {
  id            String               @id @default(uuid())
  userId        String
  title         String?
  company       String?
  rawText       String
  status        JobDescriptionStatus @default(READY)
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis      JobAnalysis?
  careerTargets CareerTarget[]
  interviews    Interview[]

  @@index([userId, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@map("job_description")
}

enum CareerTargetStatus {
  ACTIVE
  ARCHIVED
}

model CareerTarget {
  id               String             @id @default(uuid())
  userId           String
  title            String
  company          String?
  jobDescriptionId String?
  jobUrl           String?
  location         String?
  resumeId         String?
  status           CareerTargetStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription   JobDescription?    @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resume           Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  interviews       Interview[]
  practicePlans    PracticePlan[]

  @@index([userId, status, createdAt])
  @@map("career_target")
}

enum InterviewStatus {
  DRAFT
  PREPARING
  READY
  IN_PROGRESS
  COMPLETING
  COMPLETED
  CANCELLED
  FAILED
}

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  CODING
  SYSTEM_DESIGN
  HR
  MIXED
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Interview {
  id               String              @id @default(uuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  careerTargetId   String?
  status           InterviewStatus     @default(DRAFT)
  interviewType    InterviewType
  difficulty       InterviewDifficulty @default(MEDIUM)
  durationMinutes  Int
  language         String              @default("en")
  targetRole       String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescription   JobDescription?     @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  careerTarget     CareerTarget?       @relation(fields: [careerTargetId], references: [id], onDelete: SetNull)
  plan             InterviewPlan?
  conversation     Conversation?
  memory           InterviewMemory?
  report           InterviewReport?

  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, status, completedAt])
  @@map("interview")
}

enum ConversationState {
  GREETING
  LISTENING
  TRANSCRIBING
  THINKING
  SPEAKING
  CLOSING
  COMPLETED
}

enum ConversationSpeaker {
  USER
  AI
  SYSTEM
}

enum ConversationTurnType {
  GREETING
  QUESTION
  ANSWER
  FOLLOW_UP
  CLARIFICATION
  CLOSING
}

model Conversation {
  id          String             @id @default(uuid())
  interviewId String             @unique
  state       ConversationState  @default(GREETING)
  sequence    Int                @default(0)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  interview   Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  turns       ConversationTurn[]

  @@map("conversation")
}

model ConversationTurn {
  id             String               @id @default(uuid())
  conversationId String
  sequence       Int
  speaker        ConversationSpeaker
  type           ConversationTurnType
  text           String
  createdAt      DateTime             @default(now())
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@map("conversation_turn")
}

model InterviewPlan {
  id               String    @id @default(uuid())
  interviewId      String    @unique
  objectives       Json
  topics           Json
  evaluationRubric Json
  timeline         Json
  followUpStrategy String
  fallbackStrategy String
  model            String
  generatedAt      DateTime  @default(now())
  version          Int       @default(1)
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_plan")
}

model InterviewMemory {
  id                  String              @id @default(uuid())
  interviewId         String              @unique
  askedQuestions      Json                @default("[]")
  topicCoverage       Json                @default("[]")
  candidateStrengths  Json                @default("[]")
  weakAreas           Json                @default("[]")
  missedFollowUps     Json                @default("[]")
  questionDifficulty  InterviewDifficulty @default(MEDIUM)
  remainingObjectives Json                @default("[]")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  interview           Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_memory")
}

model InterviewReport {
  id                   String                @id @default(uuid())
  interviewId          String                @unique
  status               ReportStatus          @default(PENDING)
  evaluation           Json?
  summary              String?
  evidence             Json                  @default("[]")
  hiringRecommendation HiringRecommendation?
  failureReason        String?
  generationAttempts   Int                   @default(0)
  generatedAt          DateTime?
  model                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  interview            Interview             @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_report")
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum HiringRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

model JobAnalysis {
  id               String         @id @default(uuid())
  jobDescriptionId String         @unique
  requiredSkills   Json
  preferredSkills  Json
  responsibilities Json
  keywords         Json
  seniority        String?
  technologyStack  Json
  generatedAt      DateTime       @default(now())
  model            String
  version          Int            @default(1)
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@map("job_analysis")
}

model PracticePlan {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  status                  String             @default("READY")
  version                 Int                @default(1)
  goal                    String
  targetRole              String?
  careerTargetId          String?
  basedOnInterviewIds     String[]           @default([])
  basedOnValidReportCount Int                @default(0)
  generatedAt             DateTime?
  failureReason           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerTarget            CareerTarget?      @relation(fields: [careerTargetId], references: [id], onDelete: SetNull)
  items                   PracticePlanItem[]

  @@map("practice_plan")
}

model PracticePlanItem {
  id               String       @id @default(uuid())
  practicePlanId   String
  position         Int          @default(0)
  phase            String
  priority         String       @default("MEDIUM")
  activityType     String
  title            String
  description      String?
  rationale        String
  estimatedMinutes Int
  status           String       @default("PENDING")
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  practicePlan     PracticePlan @relation(fields: [practicePlanId], references: [id], onDelete: Cascade)

  @@index([practicePlanId])
  @@map("practice_plan_item")
}

model SkillAnalysis {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  status                  String    @default("GENERATING")
  version                 Int       @default(1)
  model                   String?
  summary                 String?
  insights                Json?
  basedOnInterviewIds     String[]  @default([])
  basedOnObservationCount Int       @default(0)
  failureReason           String?
  generatedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skill_analysis")
}

enum ReadinessTrigger {
  REPORT_READY
  MANUAL
}

model ReadinessSnapshot {
  id               String           @id @default(uuid())
  userId           String
  careerTargetId   String?
  overall          Int
  components       Json
  formulaVersion   Int
  interviewCount   Int
  validReportCount Int
  trigger          ReadinessTrigger @default(REPORT_READY)
  recordedAt       DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerTargetId, validReportCount])
  @@index([userId, recordedAt])
  @@index([userId, careerTargetId, recordedAt])
  @@map("readiness_snapshot")
}

enum BillingProvider {
  PADDLE
}

enum BillingPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum UsageResource {
  MOCK_INTERVIEW
  AI_ANALYSIS
}

enum UsageRecordStatus {
  RESERVED
  COMMITTED
  RELEASED
}

/// The application's relationship with a billing-provider customer. Paddle is
/// the source of truth for the financial relationship; this row only maps the
/// external customer to exactly one application user.
model BillingCustomer {
  id                 String          @id @default(uuid())
  userId             String
  provider           BillingProvider @default(PADDLE)
  providerCustomerId String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerCustomerId])
  @@map("billing_customer")
}

/// Local, webhook-synchronized copy of the provider's subscription state. This
/// is the authoritative source for application access decisions so that no
/// request ever depends on a live provider API call.
model Subscription {
  id                         String             @id @default(uuid())
  userId                     String
  provider                   BillingProvider    @default(PADDLE)
  providerSubscriptionId     String
  providerCustomerId         String
  plan                       BillingPlan        @default(FREE)
  status                     SubscriptionStatus
  billingInterval            BillingInterval?
  currentPeriodStart         DateTime?
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean            @default(false)
  scheduledChange            Json?
  scheduledChangeEffectiveAt DateTime?
  providerCreatedAt          DateTime?
  providerUpdatedAt          DateTime?
  lastEventType              String?
  lastWebhookOccurredAt      DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords               UsageRecord[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@index([provider, providerCustomerId])
  @@map("subscription")
}

/// Durable, deduplicated record of every provider webhook delivery. Webhook
/// delivery is at-least-once and unordered, so the unique event key plus the
/// stored occurredAt are what make processing idempotent and order-safe.
model BillingEvent {
  id              String             @id @default(uuid())
  provider        BillingProvider    @default(PADDLE)
  providerEventId String
  eventType       String
  occurredAt      DateTime
  status          BillingEventStatus @default(PENDING)
  payload         Json
  error           String?
  attempts        Int                @default(0)
  processedAt     DateTime?
  userId          String?
  subscriptionId  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([status, occurredAt])
  @@index([userId, occurredAt])
  @@map("billing_event")
}

/// Append-only ledger of metered consumption. Quantity is never inferred from
/// client input: rows are written by server operations that carry a stable
/// reference so a retried request cannot consume twice.
model UsageRecord {
  id             String            @id @default(uuid())
  userId         String
  subscriptionId String?
  resource       UsageResource
  quantity       Int               @default(1)
  periodStart    DateTime
  periodEnd      DateTime
  referenceType  String
  referenceId    String
  status         UsageRecordStatus @default(RESERVED)
  committedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([resource, referenceType, referenceId])
  @@index([userId, resource, periodStart])
  @@index([userId, resource, status])
  @@map("usage_record")
}

/// Materialized per-period consumption counter. Limit enforcement is a single
/// conditional atomic upsert against this row, which is what makes concurrent
/// requests unable to exceed a limit.
model UsageCounter {
  id          String        @id @default(uuid())
  userId      String
  resource    UsageResource
  periodStart DateTime
  periodEnd   DateTime
  used        Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, periodStart])
  @@map("usage_counter")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model AuthEmailOutbox {
  id          String    @id
  eventKey    String?   @unique
  recipient   String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availableAt])
  @@index([userId])
  @@map("auth_email_outbox")
}
