generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id
  name            String
  email           String            @unique
  emailVerified   Boolean           @default(false)
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts        Account[]
  authEmailOutbox AuthEmailOutbox[]
  sessions        Session[]
  resumes         Resume[]
  jobDescriptions JobDescription[]

  @@map("user")
}

enum ResumeStatus {
  PENDING_UPLOAD
  READY
  ANALYZING
  ANALYZED
  FAILED
  DELETED
}

model Resume {
  id        String       @id @default(uuid())
  userId    String
  storageKey String      @unique
  fileName  String
  mimeType  String
  fileSize  Int
  status    ResumeStatus @default(PENDING_UPLOAD)
  isActive  Boolean      @default(false)
  uploadedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis  ResumeAnalysis?

  @@index([userId, createdAt])
  @@index([userId, isActive])
  @@map("resume")
}

model ResumeAnalysis {
  id          String   @id @default(uuid())
  resumeId    String   @unique
  summary     String
  skills      Json
  technologies Json
  experience  Json
  education   Json
  projects    Json
  certifications Json
  generatedAt DateTime @default(now())
  model       String
  version     Int      @default(1)
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analysis")
}

enum JobDescriptionStatus {
  READY
  ANALYZING
  ANALYZED
  FAILED
  DELETED
}

model JobDescription {
  id        String               @id @default(uuid())
  userId    String
  title     String?
  company   String?
  rawText   String
  status    JobDescriptionStatus @default(READY)
  deletedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis  JobAnalysis?

  @@index([userId, createdAt])
  @@map("job_description")
}

model JobAnalysis {
  id                String   @id @default(uuid())
  jobDescriptionId  String   @unique
  requiredSkills    Json
  preferredSkills   Json
  responsibilities  Json
  keywords          Json
  seniority         String?
  technologyStack   Json
  generatedAt       DateTime @default(now())
  model             String
  version           Int      @default(1)
  jobDescription    JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@map("job_analysis")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model AuthEmailOutbox {
  id          String    @id
  eventKey    String?   @unique
  recipient   String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availableAt])
  @@index([userId])
  @@map("auth_email_outbox")
}
