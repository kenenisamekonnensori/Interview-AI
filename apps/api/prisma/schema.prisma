generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id
  name            String
  email           String            @unique
  emailVerified   Boolean           @default(false)
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts        Account[]
  authEmailOutbox AuthEmailOutbox[]
  sessions        Session[]
  resumes         Resume[]
  jobDescriptions JobDescription[]
  interviews      Interview[]
  profile         UserProfile?

  @@map("user")
}

model UserProfile {
  id                       String              @id @default(uuid())
  userId                   String              @unique
  preferredName            String?
  profession               String?
  targetRole               String?
  seniority                String?
  yearsOfExperience        Int?
  preferredLanguage        String              @default("en")
  defaultInterviewDuration Int                 @default(30)
  defaultDifficulty        InterviewDifficulty @default(MEDIUM)
  voicePreference          String?
  accessibilityPreferences Json                @default("{}")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

enum ResumeStatus {
  PENDING_UPLOAD
  READY
  ANALYZING
  ANALYZED
  FAILED
  DELETED
}

model Resume {
  id        String       @id @default(uuid())
  userId    String
  storageKey String      @unique
  fileName  String
  mimeType  String
  fileSize  Int
  status    ResumeStatus @default(PENDING_UPLOAD)
  isActive  Boolean      @default(false)
  uploadedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis  ResumeAnalysis?
  interviews Interview[]

  @@index([userId, createdAt])
  @@index([userId, isActive])
  @@index([userId, deletedAt, isActive, createdAt])
  @@map("resume")
}

model ResumeAnalysis {
  id          String   @id @default(uuid())
  resumeId    String   @unique
  summary     String
  skills      Json
  technologies Json
  experience  Json
  education   Json
  projects    Json
  certifications Json
  generatedAt DateTime @default(now())
  model       String
  version     Int      @default(1)
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analysis")
}

enum JobDescriptionStatus {
  READY
  ANALYZING
  ANALYZED
  FAILED
  DELETED
}

model JobDescription {
  id        String               @id @default(uuid())
  userId    String
  title     String?
  company   String?
  rawText   String
  status    JobDescriptionStatus @default(READY)
  deletedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis  JobAnalysis?
  interviews Interview[]

  @@index([userId, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@map("job_description")
}

enum InterviewStatus {
  DRAFT
  PREPARING
  READY
  IN_PROGRESS
  COMPLETING
  COMPLETED
  CANCELLED
  FAILED
}

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  CODING
  SYSTEM_DESIGN
  HR
  MIXED
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Interview {
  id               String              @id @default(uuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  status           InterviewStatus     @default(DRAFT)
  interviewType    InterviewType
  difficulty       InterviewDifficulty @default(MEDIUM)
  durationMinutes  Int
  language         String              @default("en")
  targetRole       String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescription   JobDescription?     @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  plan             InterviewPlan?
  conversation     Conversation?
  memory           InterviewMemory?
  report           InterviewReport?

  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, status, completedAt])
  @@map("interview")
}

enum ConversationState {
  GREETING
  LISTENING
  TRANSCRIBING
  THINKING
  SPEAKING
  CLOSING
  COMPLETED
}
enum ConversationSpeaker {
  USER
  AI
  SYSTEM
}
enum ConversationTurnType {
  GREETING
  QUESTION
  ANSWER
  FOLLOW_UP
  CLARIFICATION
  CLOSING
}

model Conversation {
  id          String            @id @default(uuid())
  interviewId String            @unique
  state       ConversationState @default(GREETING)
  sequence    Int               @default(0)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  interview   Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  turns       ConversationTurn[]
  @@map("conversation")
}

model ConversationTurn {
  id             String               @id @default(uuid())
  conversationId String
  sequence       Int
  speaker        ConversationSpeaker
  type           ConversationTurnType
  text           String
  createdAt      DateTime             @default(now())
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@unique([conversationId, sequence])
  @@map("conversation_turn")
}

model InterviewPlan {
  id            String   @id @default(uuid())
  interviewId   String   @unique
  objectives    Json
  topics        Json
  evaluationRubric Json
  timeline      Json
  followUpStrategy String
  fallbackStrategy String
  model         String
  generatedAt   DateTime @default(now())
  version       Int      @default(1)
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_plan")
}

model InterviewMemory {
  id                       String   @id @default(uuid())
  interviewId              String   @unique
  askedQuestions           Json     @default("[]")
  topicCoverage            Json     @default("[]")
  candidateStrengths       Json     @default("[]")
  weakAreas                Json     @default("[]")
  missedFollowUps          Json     @default("[]")
  questionDifficulty       InterviewDifficulty @default(MEDIUM)
  remainingObjectives      Json     @default("[]")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  interview                Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_memory")
}

model InterviewReport {
  id                 String               @id @default(uuid())
  interviewId        String               @unique
  status             ReportStatus         @default(PENDING)
  evaluation         Json?
  summary            String?
  evidence           Json                 @default("[]")
  hiringRecommendation HiringRecommendation?
  failureReason      String?
  generationAttempts Int                  @default(0)
  generatedAt        DateTime?
  model              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  interview          Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_report")
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum HiringRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

model JobAnalysis {
  id                String   @id @default(uuid())
  jobDescriptionId  String   @unique
  requiredSkills    Json
  preferredSkills   Json
  responsibilities  Json
  keywords          Json
  seniority         String?
  technologyStack   Json
  generatedAt       DateTime @default(now())
  model             String
  version           Int      @default(1)
  jobDescription    JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@map("job_analysis")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model AuthEmailOutbox {
  id          String    @id
  eventKey    String?   @unique
  recipient   String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availableAt])
  @@index([userId])
  @@map("auth_email_outbox")
}
