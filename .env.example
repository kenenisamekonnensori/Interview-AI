# Production environment template. Copy to .env.production for the Docker Compose template.
# Never commit real values. All values below are server-only unless explicitly marked PUBLIC.

NODE_ENV=production

# Web/API origins
# PUBLIC: baked into the Next.js web image at build time.
NEXT_PUBLIC_API_URL=https://api.example.com
# SERVER-ONLY: exact browser origin used for CORS and auth redirects.
WEB_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=true
API_PORT=4000

# Authentication (SERVER-ONLY)
BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# PostgreSQL and Redis (SERVER-ONLY; use TLS URLs where the provider requires them)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/interviewer_ai?schema=public
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Email (SERVER-ONLY)
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Interviewer AI <no-reply@example.com>

# Gemini reasoning and Deepgram voice (SERVER-ONLY)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPGRAM_API_KEY=replace-with-deepgram-api-key

# Cloudflare R2 / S3-compatible object storage (SERVER-ONLY)
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=interviewer-ai-resumes
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
