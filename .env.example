# Production environment template. Copy to .env.production for the Docker Compose template.
# Never commit real values. All values below are server-only unless explicitly marked PUBLIC.

NODE_ENV=production

# Web/API origins
# PUBLIC: baked into the Next.js web image at build time.
NEXT_PUBLIC_API_URL=https://api.example.com
# SERVER-ONLY: exact browser origin used for CORS and auth redirects.
WEB_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=true
API_PORT=4000

# Authentication (SERVER-ONLY)
BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# Optional: when GITHUB_CLIENT_ID/SECRET are set, GitHub is enabled as a sign-in provider alongside Google.
# GitHub OAuth apps must use the callback URL: BETTER_AUTH_URL/api/auth/callback/github

# PostgreSQL and Redis (SERVER-ONLY; use TLS URLs where the provider requires them)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/interviewer_ai?schema=public
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Email (SERVER-ONLY)
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Interviewer AI <no-reply@example.com>

# Gemini reasoning and Deepgram voice (SERVER-ONLY)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPGRAM_API_KEY=replace-with-deepgram-api-key

# Cloudflare R2 / S3-compatible object storage (SERVER-ONLY)
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=interviewer-ai-resumes
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Paddle Billing (SERVER-ONLY)
# PADDLE_ENVIRONMENT=sandbox for sandbox testing; must be "production" in production.
# Sandbox and production credentials must never be mixed.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=replace-with-paddle-api-key
# Only required if the Paddle.js overlay checkout is enabled; the default flow
# redirects the browser to Paddle's hosted checkout URL.
PADDLE_CLIENT_TOKEN=replace-with-paddle-client-token
PADDLE_WEBHOOK_SECRET=replace-with-paddle-webhook-signing-secret
# Internal plan -> Paddle catalog mapping. Prices are never hardcoded in code.
PADDLE_PRO_PRODUCT_ID=replace-with-paddle-pro-product-id
PADDLE_PRO_MONTHLY_PRICE_ID=replace-with-paddle-pro-monthly-price-id
PADDLE_PRO_YEARLY_PRICE_ID=replace-with-paddle-pro-yearly-price-id
